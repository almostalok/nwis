datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WellType {
  EXPLORATION
  DEVELOPMENT
  APPRAISAL
  WILDCAT
  STRATIGRAPHIC
}

enum WellStatus {
  PLANNED
  DRILLING
  COMPLETED
  SUSPENDED
  ABANDONED
}

enum EventType {
  LOST_CIRCULATION
  KICK
  STUCK_PIPE
  FISHING
  NPT
  TORQUE_SPIKE
  PRESSURE_ANOMALY
  FORMATION_INSTABILITY
  CASING_EVENT
  CEMENTING_EVENT
  EQUIPMENT_FAILURE
  OTHER
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum QualityStatus {
  VALID
  WARNING
  INVALID
  UNVERIFIED
  VERIFIED
}

enum DocumentType {
  WCR
  DDR
  MUD_REPORT
  GEOLOGICAL_REPORT
  CEMENTING_REPORT
  CASING_REPORT
  DRILLING_REPORT
  INCIDENT_REPORT
  OTHER
}

enum DocumentProcessingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  TEXT_EXTRACTION
  OCR_PROCESSING
  CHUNKING
  ENTITY_EXTRACTION
  EVENT_EXTRACTION
  EMBEDDING
  PROCESSED
  COMPLETED
  FAILED
  VERIFIED
  VERIFICATION_REQUIRED
}

enum DataSourceType {
  SYNTHETIC
  CSV
  EXCEL
  WITSML
  ERTMAC
  DOCUMENT
  API
}

enum UserRole {
  ADMIN
  DRILLING_ENGINEER
  GEOLOGIST
  MANAGER
  DATA_ENGINEER
  VIEWER
}

enum AuditAction {
  LOGIN
  DATA_IMPORT
  DATA_UPDATE
  DOCUMENT_UPLOAD
  EVENT_UPDATE
  USER_UPDATE
  ALERT_CREATED
  ALERT_ACKNOWLEDGED
  ALERT_RESOLVED
  ALERT_DISMISSED
  ALERT_ESCALATED
  SIMULATION_STARTED
  SIMULATION_STOPPED
  MANUAL_OVERRIDE
}

enum SensorQuality {
  GOOD
  SUSPECT
  MISSING
  STALE
  OUT_OF_RANGE
  INVALID
  DUPLICATE
}

enum AlertSeverity {
  NORMAL
  WATCH
  WARNING
  CRITICAL
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
  DISMISSED
}

enum DrillingState {
  DRILLING
  SLIDING
  ROTATING
  CONNECTION
  TRIPPING
  CIRCULATING
  REAMING
  CEMENTING
  STATIC
  UNKNOWN
}

enum RiskType {
  STUCK_PIPE
  LOST_CIRCULATION
  KICK
  PRESSURE_ANOMALY
  TORQUE_ANOMALY
  CEMENTING_RISK
  FORMATION_INSTABILITY
}

enum SimulationScenario {
  NORMAL_DRILLING
  TORQUE_SPIKE
  ROP_DROP
  STUCK_PIPE_PRECURSOR
  LOST_CIRCULATION
  KICK_PRECURSOR
  PRESSURE_ANOMALY
  FORMATION_INSTABILITY
}

enum SimulationState {
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
}

model Well {
  id              String         @id @default(uuid())
  wellId          String         @unique
  name            String
  field           String
  operator        String         @default("Oil India Limited (Synthetic)")
  wellType        WellType       @default(DEVELOPMENT)
  status          WellStatus     @default(DRILLING)
  spudDate        DateTime?
  completionDate  DateTime?
  totalDepth      Float          // in meters canonical
  latitude        Float
  longitude       Float
  qualityStatus   QualityStatus  @default(VALID)
  qualityScore    Float          @default(1.0)
  sourceId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  trajectoryPoints   WellTrajectoryPoint[]
  formations         FormationInterval[]
  drillingParameters DrillingParameterSample[]
  mudSamples         MudSample[]
  events             OperationalEvent[]
  casingSections     CasingSection[]
  cementingJobs      CementingJob[]
  documents          Document[]
  realtimeSamples    RealtimeDrillingSample[]
  alerts             Alert[]
  contextSnapshots   ContextSnapshot[]

  @@index([field])
  @@index([status])
  @@index([latitude, longitude])
  @@map("wells")
}

model WellTrajectoryPoint {
  id                String    @id @default(uuid())
  wellId            String
  measuredDepth     Float     // in meters canonical
  trueVerticalDepth Float     // in meters canonical
  inclination       Float     // degrees (0 - 180)
  azimuth           Float     // degrees (0 - 360)
  latitude          Float?
  longitude         Float?
  northing          Float?
  easting           Float?
  dogLegSeverity    Float?    // deg/30m
  timestamp         DateTime?
  createdAt         DateTime  @default(now())

  well Well @relation(fields: [wellId], references: [id], onDelete: Cascade)

  @@index([wellId, measuredDepth])
  @@map("well_trajectory_points")
}

model FormationInterval {
  id            String        @id @default(uuid())
  wellId        String
  formationName String
  topDepth      Float         // in meters canonical
  bottomDepth   Float         // in meters canonical
  topTVD        Float?
  bottomTVD     Float?
  lithology     String
  reservoir     Boolean       @default(false)
  confidence    Float         @default(1.0)
  sourceId      String?
  qualityStatus QualityStatus @default(VALID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  well   Well               @relation(fields: [wellId], references: [id], onDelete: Cascade)
  events OperationalEvent[]

  @@index([wellId])
  @@index([formationName])
  @@index([topDepth, bottomDepth])
  @@map("formation_intervals")
}

model DrillingParameterSample {
  id                String        @id @default(uuid())
  wellId            String
  timestamp         DateTime
  measuredDepth     Float         // in meters canonical
  rop               Float?        // Rate of Penetration (m/h)
  wob               Float?        // Weight on Bit (kN)
  rpm               Float?        // Rotary RPM
  torque            Float?        // Torque (kN.m)
  hookLoad          Float?        // Hook Load (kN)
  standpipePressure Float?        // Standpipe Pressure (bar)
  flowRate          Float?        // Flow Rate (lpm)
  blockPosition     Float?        // Block Position (m)
  blockSpeed        Float?        // Block Speed (m/s)
  additionalTags    Json?         // Flexible sensor extensions
  qualityStatus     QualityStatus @default(VALID)
  createdAt         DateTime      @default(now())

  well Well @relation(fields: [wellId], references: [id], onDelete: Cascade)

  @@index([wellId, measuredDepth])
  @@index([wellId, timestamp])
  @@map("drilling_parameter_samples")
}

model MudSample {
  id                   String        @id @default(uuid())
  wellId               String
  timestamp            DateTime
  measuredDepth        Float         // in meters canonical
  mudWeight            Float?        // specific gravity (sg) canonical
  plasticViscosity     Float?        // cP
  yieldPoint           Float?        // lb/100ft2
  funnelViscosity      Float?        // sec/qt
  fluidLoss            Float?        // ml/30min
  ph                   Float?
  chlorides            Float?        // mg/l
  solids               Float?        // % vol
  flowRate             Float?        // lpm
  pitVolume            Float?        // m3
  gasReading           Float?        // units
  additionalProperties Json?
  qualityStatus        QualityStatus @default(VALID)
  createdAt            DateTime      @default(now())

  well Well @relation(fields: [wellId], references: [id], onDelete: Cascade)

  @@index([wellId, measuredDepth])
  @@index([wellId, timestamp])
  @@map("mud_samples")
}

model OperationalEvent {
  id                   String        @id @default(uuid())
  wellId               String
  eventType            EventType
  severity             EventSeverity
  startDepth           Float         // in meters canonical
  endDepth             Float?        // in meters canonical
  startTime            DateTime?
  endTime              DateTime?
  formationId          String?
  description          String
  rootCause            String?
  mitigation           String?
  outcome              String?
  confidence           Float         @default(1.0)
  sourceDocumentId     String?
  sourcePage           Int?
  sourceLocation       String?
  extractionMethod     String?       @default("MANUAL")
  extractionConfidence Float?        @default(1.0)
  verifiedBy           String?
  verifiedAt           DateTime?
  qualityStatus        QualityStatus @default(VALID)
  qualityScore         Float         @default(1.0)
  precedingIndicators  Json?         // e.g. ["TORQUE_SPIKE", "ROP_DECREASE", "DRAG_INCREASE"]
  problemDescription  String?
  mitigationAction     String?
  lessonsLearned       String?
  dedupKey             String?       // Canonical hash for event deduplication
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  well      Well                      @relation(fields: [wellId], references: [id], onDelete: Cascade)
  formation FormationInterval?        @relation(fields: [formationId], references: [id], onDelete: SetNull)
  document  Document?                 @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  evidence  HistoricalEventEvidence[]

  @@index([wellId])
  @@index([eventType])
  @@index([startDepth])
  @@index([formationId])
  @@index([dedupKey])
  @@map("operational_events")
}

model CasingSection {
  id               String   @id @default(uuid())
  wellId           String
  section          String
  casingSize       Float    // in inches, e.g. 13.375
  settingDepth     Float    // meters canonical
  topDepth         Float
  bottomDepth      Float
  grade            String?
  weight           Float?
  cementTop        Float?
  cementBottom     Float?
  sourceDocumentId String?
  createdAt        DateTime @default(now())

  well          Well           @relation(fields: [wellId], references: [id], onDelete: Cascade)
  cementingJobs CementingJob[]

  @@index([wellId])
  @@map("casing_sections")
}

model CementingJob {
  id                 String    @id @default(uuid())
  wellId             String
  casingId           String?
  jobDate            DateTime?
  topDepth           Float
  bottomDepth        Float
  cementVolume       Float?    // m3
  cementDensity      Float?    // sg
  slurryType         String?
  displacementVolume Float?
  jobStatus          String    @default("SUCCESS")
  remarks            String?
  sourceDocumentId   String?
  createdAt          DateTime  @default(now())

  well   Well           @relation(fields: [wellId], references: [id], onDelete: Cascade)
  casing CasingSection? @relation(fields: [casingId], references: [id], onDelete: SetNull)

  @@index([wellId])
  @@map("cementing_jobs")
}

model Document {
  id               String                   @id @default(uuid())
  wellId           String?
  documentType     DocumentType
  title            String
  fileName         String
  mimeType         String
  storagePath      String
  documentDate     DateTime?
  pageCount        Int?
  processingStatus DocumentProcessingStatus @default(COMPLETED)
  extractionStatus String?                  @default("COMPLETED")
  ocrConfidence    Float?                   @default(1.0)
  checksum         String?
  sourceSystem     String?                  @default("NWIS-LOCAL-STORE")
  metadata         Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  well               Well?                     @relation(fields: [wellId], references: [id], onDelete: Cascade)
  events             OperationalEvent[]
  chunks             DocumentChunk[]
  evidence           HistoricalEventEvidence[]
  extractedEntities  ExtractedEntity[]

  @@index([wellId])
  @@index([documentType])
  @@map("documents")
}

model DocumentChunk {
  id          String   @id @default(uuid())
  documentId  String
  pageNumber  Int
  chunkIndex  Int
  text        String
  section     String?
  startOffset Int?
  endOffset   Int?
  tokenCount  Int?
  embedding   Json?    // Vector representation
  metadata    Json?
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([pageNumber])
  @@map("document_chunks")
}

model HistoricalEventEvidence {
  id          String   @id @default(uuid())
  eventId     String
  documentId  String
  pageNumber  Int
  textExcerpt String
  confidence  Float    @default(1.0)
  createdAt   DateTime @default(now())

  event    OperationalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([documentId])
  @@map("historical_event_evidence")
}

model ExtractedEntity {
  id              String   @id @default(uuid())
  documentId      String
  entityType      String   // WELL, DEPTH, FORMATION, DRILLING_PARAM, EVENT, ACTION
  value           String
  normalizedValue String?
  confidence      Float    @default(1.0)
  pageNumber      Int
  textSpan        String?
  metadata        Json?
  createdAt       DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([entityType])
  @@map("extracted_entities")
}

model DataSource {
  id             String         @id @default(uuid())
  name           String
  type           DataSourceType
  description    String?
  version        String?
  connectionType String?
  active         Boolean        @default(true)
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("data_sources")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(VIEWER)
  department   String?   @default("Drilling Services")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  timestamp  DateTime    @default(now())
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([timestamp])
  @@map("audit_logs")
}

model IngestionJobRecord {
  id               String         @id @default(uuid())
  sourceType       DataSourceType
  sourceIdentifier String
  status           String         @default("PENDING")
  totalRecords     Int            @default(0)
  processedRecords Int            @default(0)
  validRecords     Int            @default(0)
  invalidRecords   Int            @default(0)
  errors           Json?
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  metadata         Json?

  @@map("ingestion_jobs")
}

model RealtimeDrillingSample {
  id                 String        @id @default(uuid())
  wellId             String
  timestamp          DateTime
  measuredDepth      Float
  trueVerticalDepth  Float?
  formationId        String?
  rop                Float?
  wob                Float?
  rpm                Float?
  torque             Float?
  hookload           Float?
  blockPosition      Float?
  blockVelocity      Float?
  standpipePressure  Float?
  annularPressure    Float?
  flowIn             Float?
  flowOut            Float?
  pumpRate           Float?
  pitVolume          Float?
  mudWeightIn        Float?
  mudWeightOut       Float?
  mudTemperature     Float?
  ecd                Float?
  drag               Float?
  bitDepth           Float?
  bitSize            Float?
  pumpPressure       Float?
  connectionState    String?
  rotaryState        String?
  circulationState   String?
  drillingState      DrillingState @default(DRILLING)
  source             String        @default("SYNTHETIC_STREAM")
  quality            SensorQuality @default(GOOD)
  qualityIssues      Json?
  createdAt          DateTime      @default(now())

  well Well @relation(fields: [wellId], references: [wellId], onDelete: Cascade)

  @@index([wellId, timestamp])
  @@index([wellId, measuredDepth])
  @@index([formationId, timestamp])
  @@map("realtime_drilling_samples")
}

model RealtimeFeature {
  id                         String   @id @default(uuid())
  wellId                     String
  timestamp                  DateTime
  windowSeconds              Int      // 30, 60, 300, 900
  torqueMean                 Float?
  torqueStd                  Float?
  torqueSlope                Float?
  torqueZScore               Float?
  torqueRobustZ              Float?
  ropMean                    Float?
  ropSlope                   Float?
  ropZScore                  Float?
  dragMean                   Float?
  dragSlope                  Float?
  sppMean                    Float?
  sppSlope                   Float?
  flowDifference             Float?
  pitVolumeChange            Float?
  mudWeightChange            Float?
  wobNormalized              Float?
  rpmNormalized              Float?
  connectionVsDrilling       String?
  formationBaselineDeviation Json?
  rawFeatures                Json?
  createdAt                  DateTime @default(now())

  @@index([wellId, timestamp])
  @@index([wellId, windowSeconds])
  @@map("realtime_features")
}

model AnomalyRecord {
  id            String        @id @default(uuid())
  wellId        String
  timestamp     DateTime
  depth         Float
  formation     String?
  parameter     String        // TORQUE, ROP, DRAG, FLOW_OUT, SPP
  observedValue Float
  expectedValue Float
  deviation     Float         // percentage or normalized diff
  severity      AlertSeverity
  method        String        // ROLLING_Z_SCORE, ROBUST_Z, TREND_SLOPE, MULTIVARIATE_RULE
  confidence    Float
  evidence      Json?
  createdAt     DateTime      @default(now())

  @@index([wellId, timestamp])
  @@index([severity])
  @@map("anomaly_records")
}

model RiskAssessment {
  id                  String        @id @default(uuid())
  wellId              String
  riskType            RiskType
  score               Float         // 0-100 prototype risk score
  severity            AlertSeverity
  confidence          Float         // 0.0-1.0 decision support confidence
  depth               Float
  formation           String?
  signals             Json          // Realtime signal array
  evidence            Json          // Parameter deviations
  contributingFactors Json          // Factor contribution breakdown (+24 torque, etc)
  historicalContext   Json?         // Similar wells and matching precedents
  recommendedReview   String
  modelVersion        String        @default("v1.0.0-rules")
  featureVersion      String        @default("v1.0.0")
  timestamp           DateTime      @default(now())

  @@index([wellId, timestamp])
  @@index([riskType])
  @@index([severity])
  @@map("risk_assessments")
}

model Alert {
  id                 String        @id @default(uuid())
  wellId             String
  riskType           RiskType
  severity           AlertSeverity
  status             AlertStatus   @default(NEW)
  title              String
  description        String
  score              Float
  confidence         Float
  detectedAt         DateTime      @default(now())
  detectedDepth      Float
  formationId        String?
  triggerSignals     Json
  historicalEvidence Json?
  sourceEvidence     Json?
  acknowledgedBy     String?
  acknowledgedAt     DateTime?
  resolvedBy         String?
  resolvedAt         DateTime?
  resolutionNote     String?
  dismissedBy        String?
  dismissedAt        DateTime?
  dismissalReason    String?
  peakScore          Float         @default(0)
  lastTriggeredAt    DateTime      @default(now())
  modelVersion       String        @default("v1.0.0-rules")
  featureVersion     String        @default("v1.0.0")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  well   Well         @relation(fields: [wellId], references: [wellId], onDelete: Cascade)
  events AlertEvent[]

  @@index([wellId, status])
  @@index([severity])
  @@index([detectedAt])
  @@map("alerts")
}

model AlertEvent {
  id            String   @id @default(uuid())
  alertId       String
  action        String   // CREATED, ESCALATED, ACKNOWLEDGED, RESOLVED, DISMISSED, SCORE_UPDATED
  actor         String   // SYSTEM, or user email
  previousState String?
  newState      String
  score         Float?
  reason        String?
  metadata      Json?
  timestamp     DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, timestamp])
  @@map("alert_events")
}

model ContextSnapshot {
  id                   String   @id @default(uuid())
  alertId              String?
  wellId               String
  timestamp            DateTime @default(now())
  depth                Float
  formation            String?
  drillingState        String
  currentParameters    Json
  recentFeatures       Json
  activeAnomalies      Json
  activeRisks          Json
  similarWells         Json
  historicalPrecedents Json
  sourceDocuments      Json
  modelVersion         String   @default("v1.0.0-rules")
  configVersion        String   @default("v1.0.0")

  well Well @relation(fields: [wellId], references: [wellId], onDelete: Cascade)

  @@index([wellId, timestamp])
  @@map("context_snapshots")
}

model SimulationSession {
  id              String             @id @default(uuid())
  wellId          String
  scenario        SimulationScenario
  state           SimulationState    @default(RUNNING)
  startDepth      Float
  currentDepth    Float
  endDepth        Float
  intervalSeconds Int                @default(5)
  speedMultiplier Float              @default(10.0)
  stepIndex       Int                @default(0)
  totalSteps      Int                @default(100)
  startedAt       DateTime           @default(now())
  completedAt     DateTime?
  metadata        Json?

  @@index([wellId, state])
  @@map("simulation_sessions")
}

