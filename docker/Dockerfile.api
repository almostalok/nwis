FROM node:22-alpine AS builder

RUN npm install -g pnpm@10.30.3

WORKDIR /app
COPY pnpm-workspace.yaml package.json turbo.json pnpm-lock.yaml* ./
COPY packages ./packages
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @nwis/database db:generate
RUN pnpm --filter @nwis/types build
RUN pnpm --filter @nwis/utils build
RUN pnpm --filter @nwis/validation build
RUN pnpm --filter @nwis/database build
RUN pnpm --filter @nwis/api build

EXPOSE 4000
CMD ["node", "apps/api/dist/main.js"]
